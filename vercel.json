{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/paola-benchea",
      "destination": "/chi-e-paola-benchea",
      "permanent": true
    },
    {
      "source": "/paola-benchea.html",
      "destination": "/chi-e-paola-benchea",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-colore-labbra",
      "destination": "/trucco-permanente-labbra-roma",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-laminazione-sopracciglia",
      "destination": "/sopracciglia",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-microblading",
      "destination": "/faq-trucco-permanente",
      "permanent": true
    },
    {
      "source": "/il-mio-studio",
      "destination": "/studio-roma-aurelia",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-sopracciglia-sfumate",
      "destination": "/sopracciglia-sfumate-roma",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-sopracciglia-pelo-realistico",
      "destination": "/sopracciglia-pelo-realistico-roma",
      "permanent": true
    },
    {
      "source": "/trucco-permanente-roma-eyeliner",
      "destination": "/eyeliner-permanente-roma",
      "permanent": true
    }
  ]
}
